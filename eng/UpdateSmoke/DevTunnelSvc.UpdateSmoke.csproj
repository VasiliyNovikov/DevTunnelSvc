<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <!-- The referenced CLI is a library in this probe; only the probe needs an app runtimeconfig. -->
    <ProjectReference Include="..\..\DevTunnelSvc\DevTunnelSvc.csproj" AdditionalProperties="GenerateRuntimeConfigurationFiles=false" />
    <!-- A version stamp alone need not move framework assemblies. Give the replacement a genuinely different bundle layout. -->
    <EmbeddedResource Condition="'$(UpdateSmokePayload)' == 'true'" Include="..\..\README.md" LogicalName="UpdateSmoke.LayoutPadding" />
  </ItemGroup>
</Project>
