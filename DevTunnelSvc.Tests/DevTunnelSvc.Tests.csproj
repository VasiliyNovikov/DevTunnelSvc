<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevTunnelSvc\DevTunnelSvc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <Include>[devtunnelsvc]*</Include>
    <ExcludeByFile>**/System.Text.Json.SourceGeneration.JsonSourceGenerator/*.g.cs,**/Microsoft.Interop.LibraryImportGenerator/LibraryImports.g.cs</ExcludeByFile>
    <CoverletOutput>$(MSBuildProjectDirectory)/../artifacts/coverage/</CoverletOutput>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <Threshold>80</Threshold>
    <ThresholdType>line,branch</ThresholdType>
  </PropertyGroup>

</Project>